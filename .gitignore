# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*

# Runtime user store (qknee/api/auth.py) — created on first use; holds
# whatever accounts get signed up on a given deployment (Argon2 hashes, not
# plaintext, but still not something to commit). users.json is the old
# JSON-file backend's path (kept ignored in case a stale one lingers
# locally) — both its historical qknee/api/ location and qknee/artifacts/,
# where it was also seen committed (see git history); qknee_users.db is
# the current default SQLite backend's path.
qknee/api/users.json
qknee/artifacts/users.json
extras/api/users.json
qknee_users.db

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml

