# Q-Knee FastAPI backend (extras/api/server.py, extras/api/auth.py) — example
# environment file. Copy to `.env` (git-ignored — see .gitignore) and fill in
# real values for your deployment. NEVER commit a real `.env` file, and never
# replace the placeholders below with a real secret before committing this
# example file itself.
#
# AUDIT.md P1 #8: qknee.api.auth.resolve_jwt_secret() refuses to start
# without a valid, sufficiently strong JWT_SECRET_KEY in a production-like
# environment (the default) — there is no committed fallback secret anymore.

# --- Environment classification -------------------------------------------
# One of: production (default if unset), development, dev, local, test.
# Anything other than the development-ish values is treated as production,
# which enforces the strict JWT-secret checks below. Set this explicitly to
# "development" on your own machine only.
QKNEE_ENV=development

# --- JWT signing secret -----------------------------------------------------
# REQUIRED in production. Must be a long, random, high-entropy string
# (minimum 32 characters) — never a word, a short string, or any variation
# of "changeme"/"secret"/"password"/etc. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave this UNSET locally only if you also set QKNEE_ALLOW_INSECURE_JWT_SECRET
# below — do not paste a real secret into this example file. The placeholder
# below is deliberately a value this project's own startup check rejects
# (too short) — copying this file to `.env` without changing it will fail
# loudly at startup instead of silently running with a weak, world-readable
# secret.
QKNEE_JWT_SECRET_KEY=changeme

# Local-development-ONLY escape hatch: with QKNEE_ENV set to a development
# value above, setting this to "1" lets the app boot with a fixed,
# publicly-known, intentionally-insecure secret instead of a real one, so a
# fresh clone can run without generating a secret first. NEVER set this for
# any deployment reachable outside your own machine.
# QKNEE_ALLOW_INSECURE_JWT_SECRET=1

# Access-token lifetime in minutes (default 60; must be in (0, 1440]).
# QKNEE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database / cache --------------------------------------------------------
# Unset ("") uses a local SQLite file (sqlite:///./qknee_users.db) — fine for
# local dev, not for a real multi-instance deployment.
# DATABASE_URL=postgresql://user:pass@host:5432/qknee
# REDIS_URL=redis://default:pass@host:6379

# Local dev/CI only — allows the user store to run purely in-memory (every
# account is lost on restart) if neither DATABASE_URL nor a local SQLite
# file is usable. Never set this in a real deployment.
# QKNEE_ALLOW_INMEMORY_DB=1

# --- Registration / rate limiting -------------------------------------------
# Gates self-service registration as role="radiologist" (the only role that
# can run diagnostic inference). Unset by default, which BLOCKS radiologist
# self-registration entirely. Distribute the value out-of-band, never commit
# it.
# QKNEE_RADIOLOGIST_INVITE_CODE=replace-with-a-real-invite-code

# QKNEE_REGISTER_RATE_LIMIT=5/minute
# QKNEE_LOGIN_RATE_LIMIT=10/minute
